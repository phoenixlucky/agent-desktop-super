{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agent-desktop MCP",
  "version": "1.0.0",
  "identifier": "dev.agentdesktop.mcpconsole",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "agent-desktop MCP 服务",
        "width": 920,
        "height": 820,
        "minWidth": 760,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/agent-desktop"],
    "icon": []
  }
}
